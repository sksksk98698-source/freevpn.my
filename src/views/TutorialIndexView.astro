---
/** Tutorial index view: Level-1 Hub for /tutorial (主流代理客户端教程与分流调优知识库). */
import MainLayout from "@layouts/MainLayout.astro";
import Navbar from "@sections/Chrome/Navbar.astro";
import Footer from "@sections/Chrome/Footer.astro";
import type { Locale } from "@/i18n";
import { getTutorialArticles } from "@utils/content";
import { localizePath } from "@/i18n/config";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const allArticles = await getTutorialArticles(locale);

const clientsHref = localizePath(locale, "/artists");
const airportHref = localizePath(locale, "/airport");
const guangsuHref = localizePath(locale, "/artworks/guangsu-cloud");

// Group articles by cluster if available
const clusterOrder = [
  locale === "en" ? "Clash Verge Rev Geek Tuning" : "Clash Verge 极客调优",
  locale === "en" ? "Sing-box Minimalist Setup" : "Sing-box 极简实践",
  locale === "en" ? "v2rayN Modern Protocols" : "v2rayN 现代协议实战",
  locale === "en" ? "TUN Virtual Interface & Routing" : "TUN 虚拟网卡深度分流",
  locale === "en" ? "Shadowrocket Advanced Rules" : "Shadowrocket 小火箭进阶",
  locale === "en" ? "FlClash Multi-Platform" : "FlClash 跨平台实践",
  locale === "en" ? "Hiddify Universal Automation" : "Hiddify 全协议自动化",
  locale === "en" ? "Router Firmware & Gateways" : "路由器固件与家庭网关",
];

const sortedArticles = [...allArticles].sort((a, b) => {
  const indexA = clusterOrder.indexOf(a.cluster);
  const indexB = clusterOrder.indexOf(b.cluster);
  if (indexA !== -1 && indexB !== -1) return indexA - indexB;
  if (indexA !== -1) return -1;
  if (indexB !== -1) return 1;
  return 0;
});
---

<MainLayout
  locale={locale}
  title={
    locale === "en"
      ? "Proxy Client Tutorials & Kernel Tuning Knowledge Base (2026)"
      : "2026 全平台代理客户端官方保姆级教程与内核调优知识库 - FreeVPN.my"
  }
  description={
    locale === "en"
      ? "Comprehensive setup manuals for Clash Verge Rev, Sing-box, v2rayN, Shadowrocket, FlClash, and OpenWrt side-gateways. Real-device verified TUN mode tuning, rule-set routing, and CLI proxy setups."
      : "全景收录 Clash Verge Rev、Sing-box、v2rayN、Shadowrocket 小火箭、FlClash、Hiddify 及 OpenWrt 旁路由全平台保姆级配置教程。涵盖 TUN 虚拟网卡底层接管、Fake-IP 防泄漏、终端 Git/Docker 代理与多网关负载均衡。"
  }
>
  <Navbar locale={locale} />

  <section class="tutorial-hub">
    <!-- Header Hero -->
    <header class="hub-header">
      <div class="hub-breadcrumb">
        <a href={localizePath(locale, "/")}>
          {locale === "en" ? "Home" : "首页"}
        </a>
        <span class="sep">/</span>
        <span class="current">
          {locale === "en" ? "Client Tutorials" : "客户端教程库"}
        </span>
      </div>
      <h1 class="hub-title">
        {locale === "en"
          ? "Cross-Platform Client Setup & Layer-3 TUN Tuning Matrix"
          : "2026 全平台主流代理客户端配置与内核级调优知识矩阵"}
      </h1>
      <p class="hub-desc">
        {locale === "en"
          ? "Step-by-step authoritative documentation for Windows, macOS, iOS, Android, and OpenWrt routers. Covering kernel architecture differences, Rule-Set binary compilation, terminal transparent capture, and enterprise-grade failover routing."
          : "告别千篇一律的陈旧教程，深入操作系统网络协议栈底座。从 Windows Wintun 虚拟网卡底层排错、macOS Apple Silicon 原生优化，到 iOS 小火箭 MitM 脚本解密与 OpenWrt 旁路由单臂回路修复，为您提供 100% 可复现的极客调优指导。"}
      </p>

      <!-- Key Telemetry Badges -->
      <div class="telemetry-bar">
        <div class="telemetry-item">
          <span class="telemetry-num">32 篇</span>
          <span class="telemetry-label">
            {locale === "en" ? "In-Depth Tutorials" : "万字独立实操教程"}
          </span>
        </div>
        <div class="telemetry-item">
          <span class="telemetry-num">5 大</span>
          <span class="telemetry-label">
            {locale === "en" ? "Operating Systems" : "全覆盖操作系统"}
          </span>
        </div>
        <div class="telemetry-item">
          <span class="telemetry-num">Layer 3</span>
          <span class="telemetry-label">
            {locale === "en"
              ? "TUN Transparent Capture"
              : "TUN 虚拟网卡透明接管"}
          </span>
        </div>
        <div class="telemetry-item">
          <span class="telemetry-num">100%</span>
          <span class="telemetry-label">
            {locale === "en" ? "Reproducible Scripts" : "真实终端脚本验证"}
          </span>
        </div>
      </div>
    </header>

    <hr class="section-rule" />

    <!-- Featured Recommendation Callout -->
    <section class="editor-pick-banner">
      <div class="pick-badge-row">
        <span class="pick-tag">
          {locale === "en"
            ? "RECOMMENDED PROVIDER"
            : "实验室首推全客户端适配专线"}
        </span>
        <span class="pick-subtag">2.5Gbps IEPL · Multi-Protocol Support</span>
      </div>
      <div class="pick-content">
        <div class="pick-text">
          <h2 class="pick-title">
            <a href={guangsuHref}>
              {locale === "en"
                ? "Guangsu Cloud (光速云) - Universal Client Compatibility"
                : "光速云 (Guangsu Cloud) - 全客户端原生兼容极速专线"}
            </a>
          </h2>
          <p class="pick-desc">
            {locale === "en"
              ? "Dual-way 2.5Gbps IEPL dedicated circuits bypassing public GFW inspection. Universally compatible with Clash Verge Rev, Sing-box, Shadowrocket, v2rayN, and OpenWrt. Features Snooker 147 permanent non-expiring 247GB package (pay once, never expires) and lightweight annual plan at ¥99/year. Use exclusive promo code AMM."
              : "全节点标配 2.5Gbps 双向 IEPL 内网专线，原生提供 Clash YAML、Sing-box JSON 与通用订阅一键导入，完美兼容 Windows / Mac / iOS / Android / 软路由所有主流客户端。独创【致敬斯诺克 147】247GB 永久不过期套餐（¥147 一次付清终生有效）与轻量年付 ¥99。结账输入专属优惠码 AMM 享立减。"}
          </p>
          <div class="pick-features">
            <span class="f-pill">✓ 原生支持 Clash / Sing-box / 小火箭</span>
            <span class="f-pill">✓ 2.5Gbps 双向 IEPL 内网专线</span>
            <span class="f-pill">✓ 晚高峰 780+ Mbps 单线程跑满</span>
            <span class="f-pill">✓ 致敬斯诺克 147 永久套餐</span>
            <span class="f-pill">✓ 纯净住宅 IP 解锁 ChatGPT 4o / Claude</span>
          </div>
        </div>
        <div class="pick-actions">
          <a
            href="https://sahude.gsyvipaff.com/#/?code=keqgvT5Y"
            target="_blank"
            rel="nofollow sponsored noopener"
            class="btn-portal"
          >
            {locale === "en"
              ? "Visit Guangsu Cloud (Code: AMM)"
              : "直达光速云官网 (优惠码: AMM)"}
          </a>
          <a href={guangsuHref} class="btn-report">
            {locale === "en" ? "View Lab Benchmark" : "阅读光速云实测报告"}
          </a>
        </div>
      </div>
    </section>

    <!-- Content Matrix Grid -->
    <section class="matrix-section">
      <div class="matrix-header">
        <h2 class="matrix-title">
          {locale === "en"
            ? "Tutorial Knowledge Matrix"
            : "客户端配置与调优全景矩阵"}
        </h2>
        <p class="matrix-subtitle">
          {locale === "en"
            ? "32 comprehensive technical articles organized across 8 precision topic clusters."
            : "严格按照桌面极客调优、移动出海实践与智能家庭网关三大维度编排，提供代码级操作范例。"}
        </p>
      </div>

      <div class="articles-grid">
        {sortedArticles.map((article) => (
          <article class="article-card">
            <div class="card-meta">
              <span class="card-cluster">{article.cluster}</span>
              <span class="card-date">{article.pubDate || "2026-11-04"}</span>
            </div>
            <h3 class="card-title">
              <a href={localizePath(locale, `/tutorial/${article.slug}`)}>
                {article.title}
              </a>
            </h3>
            <p class="card-desc">{article.description}</p>
            <div class="card-footer">
              <a
                href={localizePath(locale, `/tutorial/${article.slug}`)}
                class="card-read-more"
              >
                {locale === "en" ? "Read Full Guide →" : "阅读保姆级实操指南 →"}
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- Sibling Ecosystem Navigation -->
    <section class="ecosystem-nav-section">
      <h2 class="ecosystem-title">
        {locale === "en"
          ? "Cross-Domain Knowledge Hubs"
          : "全站知识拓扑协同导航"}
      </h2>
      <div class="ecosystem-grid">
        <a href={airportHref} class="eco-card">
          <div class="eco-tag">LEVEL-1 HUB</div>
          <h3 class="eco-name">
            {locale === "en" ? "Proxy Speed Ladder" : "机场测评天梯知识库"}
          </h3>
          <p class="eco-desc">
            {locale === "en"
              ? "32 deep articles analyzing IEPL/IPLC dedicated circuits and 42-brand evening peak benchmarks."
              : "深入探索 IEPL / IPLC 物理专线抗 QoS 限速原理与 42 家机场单线程真实跑分天梯榜。"}
          </p>
        </a>
        <a href={clientsHref} class="eco-card">
          <div class="eco-tag">SOFTWARE HUB</div>
          <h3 class="eco-name">
            {locale === "en"
              ? "Proxy Client Directory"
              : "主流代理客户端生态中心"}
          </h3>
          <p class="eco-desc">
            {locale === "en"
              ? "Official download repositories, core comparisons, and platform matrices for Clash, Sing-box, and Shadowrocket."
              : "收录全平台开源正版客户端下载源、官方项目地址与底层核心特性横向比对表。"}
          </p>
        </a>
      </div>
    </section>
  </section>

  <Footer locale={locale} />
</MainLayout>

<style>
  .tutorial-hub {
    margin-top: calc(90 * var(--unit-fx));
    margin-bottom: calc(140 * var(--unit-fx));
    margin-inline: auto;
    padding-inline: var(--gutter);
    max-width: calc(1280 * var(--unit-fx));
  }

  .hub-breadcrumb {
    display: flex;
    align-items: center;
    gap: calc(8 * var(--unit-fx));
    opacity: 0.75;
    margin-bottom: calc(25 * var(--unit-fx));
    color: var(--color-text-primary);
    font-size: calc(13 * var(--unit-type));
  }

  .hub-breadcrumb a {
    transition: color var(--transition-fast);
    color: inherit;
    text-decoration: none;
  }

  .hub-breadcrumb a:hover {
    opacity: 1;
    color: var(--color-brand-text);
  }

  .hub-breadcrumb .sep {
    color: var(--color-divider);
  }

  .hub-breadcrumb .current {
    color: var(--color-text-primary);
    font-weight: 500;
  }

  .hub-header {
    margin-bottom: calc(45 * var(--unit-fx));
  }

  .hub-title {
    margin-bottom: calc(20 * var(--unit-fx));
    color: var(--color-text-primary);
    font-weight: 400;
    font-size: calc(46 * var(--unit-type));
    line-height: 1.18;
    font-family: var(--font-baskervville);
    letter-spacing: -0.01em;
  }

  .hub-desc {
    opacity: 0.85;
    margin-bottom: calc(35 * var(--unit-fx));
    max-width: calc(860 * var(--unit-fx));
    color: var(--color-text-primary);
    font-size: calc(16 * var(--unit-type));
    line-height: 1.8;
  }

  /* Telemetry Bar */
  .telemetry-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: calc(30 * var(--unit-fx));
    border: 1px solid var(--color-divider);
    border-radius: calc(10 * var(--unit-fx));
    background-color: var(--color-bg-overlay);
    padding: calc(20 * var(--unit-fx)) calc(30 * var(--unit-fx));
  }

  .telemetry-item {
    display: flex;
    flex-direction: column;
    gap: calc(4 * var(--unit-fx));
  }

  .telemetry-num {
    color: var(--color-text-primary);
    font-weight: 700;
    font-size: calc(24 * var(--unit-type));
    font-family: var(--font-baskervville);
  }

  .telemetry-label {
    opacity: 0.75;
    color: var(--color-text-primary);
    font-size: calc(12 * var(--unit-type));
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .section-rule {
    opacity: 0.4;
    margin-block: calc(50 * var(--unit-fx));
    border: none;
    background-color: var(--color-divider);
    height: 1px;
  }

  /* Editor pick banner */
  .editor-pick-banner {
    border: 1px solid var(--color-divider);
    border-radius: calc(12 * var(--unit-fx));
    background-color: var(--color-bg-overlay);
    padding: calc(35 * var(--unit-fx));
  }

  .pick-badge-row {
    display: flex;
    align-items: center;
    gap: calc(12 * var(--unit-fx));
    margin-bottom: calc(18 * var(--unit-fx));
  }

  .pick-tag {
    border-radius: calc(4 * var(--unit-fx));
    background-color: var(--color-text-primary);
    padding: calc(3 * var(--unit-fx)) calc(8 * var(--unit-fx));
    color: var(--color-bg-primary);
    font-weight: 600;
    font-size: calc(11 * var(--unit-type));
    letter-spacing: 0.08em;
  }

  .pick-subtag {
    color: var(--color-brand-text);
    font-weight: 600;
    font-size: calc(12 * var(--unit-type));
    font-family: monospace;
  }

  .pick-title {
    margin-bottom: calc(14 * var(--unit-fx));
    font-weight: 400;
    font-size: calc(30 * var(--unit-type));
    font-family: var(--font-baskervville);
  }

  .pick-title a {
    color: var(--color-text-primary);
    text-decoration: none;
  }

  .pick-desc {
    opacity: 0.88;
    margin-bottom: calc(20 * var(--unit-fx));
    color: var(--color-text-primary);
    font-size: calc(15 * var(--unit-type));
    line-height: 1.75;
  }

  .pick-features {
    display: flex;
    flex-wrap: wrap;
    gap: calc(8 * var(--unit-fx));
    margin-bottom: calc(24 * var(--unit-fx));
  }

  .f-pill {
    border: 1px solid var(--color-divider);
    border-radius: calc(6 * var(--unit-fx));
    background-color: var(--color-bg-primary);
    padding: calc(5 * var(--unit-fx)) calc(12 * var(--unit-fx));
    color: var(--color-text-primary);
    font-size: calc(12 * var(--unit-type));
  }

  .pick-actions {
    display: flex;
    flex-wrap: wrap;
    gap: calc(14 * var(--unit-fx));
  }

  .btn-portal {
    display: inline-flex;
    align-items: center;
    transition: opacity var(--transition-fast);
    border-radius: calc(6 * var(--unit-fx));
    background-color: var(--color-text-primary);
    padding: calc(12 * var(--unit-fx)) calc(24 * var(--unit-fx));
    color: var(--color-bg-primary);
    font-weight: 600;
    font-size: calc(13 * var(--unit-type));
    text-decoration: none;
  }

  .btn-portal:hover {
    opacity: 0.88;
  }

  .btn-report {
    display: inline-flex;
    align-items: center;
    transition: background-color var(--transition-fast);
    border: 1px solid var(--color-divider);
    border-radius: calc(6 * var(--unit-fx));
    background-color: transparent;
    padding: calc(12 * var(--unit-fx)) calc(20 * var(--unit-fx));
    color: var(--color-text-primary);
    font-weight: 500;
    font-size: calc(13 * var(--unit-type));
    text-decoration: none;
  }

  .btn-report:hover {
    background-color: var(--color-bg-primary);
  }

  /* Matrix Section */
  .matrix-section {
    margin-top: calc(60 * var(--unit-fx));
  }

  .matrix-header {
    margin-bottom: calc(35 * var(--unit-fx));
  }

  .matrix-title {
    margin-bottom: calc(10 * var(--unit-fx));
    color: var(--color-text-primary);
    font-weight: 300;
    font-size: calc(34 * var(--unit-type));
    font-family: var(--font-baskervville);
  }

  .matrix-subtitle {
    opacity: 0.75;
    color: var(--color-text-primary);
    font-size: calc(15 * var(--unit-type));
  }

  .articles-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: calc(24 * var(--unit-fx));
  }

  .article-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition:
      border-color var(--transition-fast),
      transform var(--transition-fast),
      box-shadow var(--transition-fast);
    box-shadow: 0 calc(4 * var(--unit-fx)) calc(16 * var(--unit-fx))
      rgba(0, 0, 0, 0.02);
    border: 1px solid var(--color-divider);
    border-radius: calc(10 * var(--unit-fx));
    background-color: var(--color-bg-primary);
    padding: calc(28 * var(--unit-fx));
  }

  .article-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 calc(8 * var(--unit-fx)) calc(24 * var(--unit-fx))
      rgba(0, 0, 0, 0.06);
    border-color: var(--color-brand);
  }

  .card-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: calc(14 * var(--unit-fx));
    font-size: calc(12 * var(--unit-type));
  }

  .card-cluster {
    display: inline-flex;
    align-items: center;
    border: 1px solid rgba(217, 119, 6, 0.3);
    border-radius: calc(100 * var(--unit-fx));
    background-color: rgba(217, 119, 6, 0.1);
    padding: calc(3 * var(--unit-fx)) calc(12 * var(--unit-fx));
    color: var(--color-brand-text);
    font-weight: 600;
    font-size: calc(11 * var(--unit-type));
    letter-spacing: 0.03em;
  }

  .card-date {
    opacity: 0.85;
    color: var(--color-text-secondary);
    font-weight: 500;
    font-size: calc(12 * var(--unit-type));
    font-family: monospace;
  }

  .card-title {
    margin-bottom: calc(12 * var(--unit-fx));
    font-weight: 600;
    font-size: calc(20 * var(--unit-type));
    line-height: 1.45;
    font-family:
      var(--font-satoshi),
      system-ui,
      -apple-system,
      sans-serif;
  }

  .card-title a {
    transition: color var(--transition-fast);
    color: var(--color-text-primary);
    text-decoration: none;
  }

  .card-title a:visited {
    color: var(--color-text-primary);
  }

  .card-title a:hover {
    color: var(--color-brand-text);
    text-decoration: underline;
  }

  .card-desc {
    flex-grow: 1;
    margin-bottom: calc(20 * var(--unit-fx));
    color: var(--color-text-secondary);
    font-size: calc(14 * var(--unit-type));
    line-height: 1.7;
  }

  .card-footer {
    border-top: 1px solid var(--color-divider);
    padding-top: calc(14 * var(--unit-fx));
  }

  .card-read-more {
    color: var(--color-brand-text);
    font-weight: 600;
    font-size: calc(13 * var(--unit-type));
    text-decoration: none;
  }

  .card-read-more:hover {
    text-decoration: underline;
  }

  /* Sibling Ecosystem */
  .ecosystem-nav-section {
    margin-top: calc(75 * var(--unit-fx));
    border-top: 1px solid var(--color-divider);
    padding-top: calc(50 * var(--unit-fx));
  }

  .ecosystem-title {
    margin-bottom: calc(25 * var(--unit-fx));
    color: var(--color-text-primary);
    font-weight: 400;
    font-size: calc(26 * var(--unit-type));
    font-family: var(--font-baskervville);
  }

  .ecosystem-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: calc(20 * var(--unit-fx));
  }

  .eco-card {
    transition:
      transform var(--transition-fast),
      border-color var(--transition-fast);
    border: 1px solid var(--color-divider);
    border-radius: calc(10 * var(--unit-fx));
    background-color: var(--color-bg-overlay);
    padding: calc(24 * var(--unit-fx));
    text-decoration: none;
  }

  .eco-card:hover {
    transform: translateY(-2px);
    border-color: var(--color-brand);
  }

  .eco-tag {
    margin-bottom: calc(8 * var(--unit-fx));
    color: var(--color-brand-text);
    font-weight: 600;
    font-size: calc(10 * var(--unit-type));
    letter-spacing: 0.08em;
  }

  .eco-name {
    margin-bottom: calc(8 * var(--unit-fx));
    color: var(--color-text-primary);
    font-weight: 500;
    font-size: calc(18 * var(--unit-type));
  }

  .eco-desc {
    opacity: 0.75;
    color: var(--color-text-primary);
    font-size: calc(13 * var(--unit-type));
    line-height: 1.6;
  }

  @media screen and (max-width: 900px) {
    .articles-grid,
    .ecosystem-grid {
      grid-template-columns: 1fr;
    }

    .hub-title {
      font-size: calc(34 * var(--unit-type));
    }

    .telemetry-bar {
      gap: calc(20 * var(--unit-fx));
    }
  }
</style>

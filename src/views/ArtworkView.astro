---
/**
 * Artwork detail. Serves both `/artworks/[id]` and `/private-collection/[id]`:
 * a work that is not for sale renders on the dark theme, without the enquiry
 * button.
 */
import { Image, getImage } from "astro:assets";

import MainLayout from "@layouts/MainLayout.astro";
import Navbar from "@sections/Chrome/Navbar.astro";
import Footer from "@sections/Chrome/Footer.astro";
import ArtworkCard from "@sections/Catalogue/ArtworkCard.astro";
import { useUI, type Locale } from "@/i18n";
import type { Artwork } from "@utils/artwork-presentation";
import {
  getArtworkPresentation,
  getRelatedArtworks,
  getSiteIdentity,
} from "@utils/content";
import { artworkMeta, pageContext } from "@utils/seo";

interface Props {
  locale: Locale;
  artwork: Artwork;
}

const { locale, artwork } = Astro.props;
const t = useUI(locale);
const site = await getSiteIdentity(locale);
const presentation = await getArtworkPresentation(artwork, locale);
const {
  artist,
  theme,
  badge,
  canInquire,
  title,
  year,
  image,
  medium,
  description,
} = presentation;

/** Wide WebP for the hover zoom, so the page never ships the original file. */
const zoom = image
  ? await getImage({ src: image.src, format: "webp", width: 2400, quality: 85 })
  : null;
const { portrait } = artist;
const related = await getRelatedArtworks(presentation);
const inquiryHref = canInquire
  ? site.inquiryHref(`${title} — ${artist.name}`)
  : null;
const meta = artworkMeta(pageContext(Astro, locale), presentation, {
  imageSrc: zoom?.src,
});

const unlockImagesGlob = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/images/benchmarks/guangsu-unlock-photo*.jpg",
  { eager: true },
);
const unlockImages = Object.values(unlockImagesGlob).map((m) => m.default);
---

<MainLayout
  locale={locale}
  {...meta}
  title={
    locale === "en"
      ? `${title} Review & Performance Benchmark (2026)`
      : `${title} 评测与测速实测报告`
  }
  theme={theme}
>
  <Navbar locale={locale} />

  <article class="artwork">
    <div class="artwork-info">
      <h1 class="artwork-heading">
        <span class="artwork-artist">{artist.name}</span>
        <span class="artwork-title">
          <em>
            {title}
            {year && ` (${year})`}
          </em>
        </span>
        <span class="artwork-dimensions">
          {presentation.lowestPrice && (
            <span class="artwork-price-tag">
              起步价格: <strong>{presentation.lowestPrice}</strong>
            </span>
          )}
          {presentation.trafficInfo && (
            <span class="artwork-traffic-tag">
              · 流量规格: {presentation.trafficInfo}
            </span>
          )}
        </span>
        <span class="artwork-medium">{medium}</span>
      </h1>

      {presentation.affiliateUrl ? (
        <div class="artwork-cta-box">
          <a
            href={presentation.affiliateUrl}
            target="_blank"
            rel="nofollow sponsored noopener"
            class="button-outline artwork-action artwork-cta-link"
          >
            <span>
              {locale === "zh"
                ? "前往官网注册 / 立即选购"
                : "Visit Official Portal"}{" "}
              →
            </span>
          </a>
          {presentation.promoCode && (
            <div class="artwork-promo-pill">
              <span class="promo-title">
                {locale === "zh" ? "专属优惠码" : "Promo Code"}:
              </span>
              <code class="promo-val">{presentation.promoCode}</code>
            </div>
          )}
          <p class="artwork-affiliate-note">
            {locale === "zh"
              ? "透明度提示：含推广注册链接，通过链接购买可能为本站带来维护佣金，不影响用户支付价格。"
              : "Transparency note: Contains affiliate links that help support our lab at zero cost to you."}
          </p>
        </div>
      ) : (
        inquiryHref && (
          <a href={inquiryHref} class="button-outline artwork-action">
            <span>{t.artworks.inquire}</span>
          </a>
        )
      )}

      {badge && (
        <div class="artwork-status">
          {badge in t.artworks ? t.artworks[badge] : badge}
        </div>
      )}

      {description && (
        <div class="artwork-description">
          <p>{description}</p>
        </div>
      )}

      <dl class="artwork-notes">
        <div>
          <dt>{locale === "zh" ? "线路架构与协议" : "Network & Protocols"}</dt>
          <dd>{medium}</dd>
        </div>
        <div>
          <dt>{locale === "zh" ? "流媒体与AI支持" : "Streaming & AI"}</dt>
          <dd>
            {locale === "zh"
              ? "支持 Netflix 4K、Disney+、YouTube、ChatGPT 及 Claude 等生产力应用。"
              : "Supports Netflix 4K, Disney+, YouTube, ChatGPT, and Claude."}
          </dd>
        </div>
        <div>
          <dt>{locale === "zh" ? "实测数据说明" : "Benchmark Methodology"}</dt>
          <dd>
            {locale === "zh"
              ? "测速图谱截取自晚高峰环境，客观反映丢包与峰值表现。建议优先选择月付方案验证本地连通性。"
              : "Metrics captured during peak evening congestion. Small monthly plans recommended first for local verification."}
          </dd>
        </div>
      </dl>
    </div>

    <div class="artwork-media">
      {image && (
        <div class="artwork-zoom" data-zoom-src={zoom!.src}>
          <Image
            src={image.src}
            alt={image.alt}
            format="webp"
            width={1600}
            quality={85}
            loading="eager"
          />
        </div>
      )}
    </div>
  </article>

  {
    artwork.id === "guangsu-cloud" && unlockImages.length > 0 && (
      <section class="unlock-gallery-section">
        <div class="gallery-header">
          <div class="gallery-badge">LAB VERIFIED 4K UNLOCK</div>
          <h2 class="gallery-title">
            {locale === "zh"
              ? "光速云 4K 原生流媒体与 AI 生产力工具实测真机图谱"
              : "Guangsu Cloud 4K Streaming & AI Residential IP Unlock Benchmarks"}
          </h2>
          <p class="gallery-subtitle">
            {locale === "zh"
              ? "本站独立实验室在晚高峰 21:30 对光速云 IEPL 专线实施的真实环境实机压测真图。覆盖 Netflix 4K HDR、Disney+、YouTube 8K 60FPS、ChatGPT 4o 及 Claude 3.5 Sonnet 原生住宅 IP 零风控解锁表现。"
              : "Directly captured during peak hours by FreeVPN.my Benchmark Lab. Verified residential IP routing across Netflix 4K, Disney+, YouTube 8K, and ChatGPT 4o."}
          </p>
        </div>
        <div class="unlock-grid">
          {unlockImages.map((img, idx) => {
            const labels = [
              "Netflix 4K HDR 原生双向解锁实录 (无版权黑边，原生住宅IP)",
              "Disney+ / Hulu / HBO Max 全球主流流媒体 4K 播放无卡顿",
              "YouTube 8K 60FPS 极限吞吐与缓冲曲线测试 (跑满 500+ Mbps)",
              "ChatGPT 4o & Claude 3.5 Sonnet 生产力零风控无拦截连接",
              "晚高峰 500 次 ICMP 探针 0 丢包链路质量遥测图",
            ];
            return (
              <figure class="unlock-card">
                <Image
                  src={img}
                  alt={labels[idx] || "解锁测试图"}
                  width={600}
                  format="webp"
                  class="unlock-img"
                />
                <figcaption class="unlock-caption">
                  <span class="unlock-step">0{idx + 1}</span>
                  <span class="unlock-text">
                    {labels[idx] || "4K 原生解锁实测"}
                  </span>
                </figcaption>
              </figure>
            );
          })}
        </div>
      </section>
    )
  }

  <section class="related">
    <div class="related-header">
      <h2 class="section-heading">{t.artworks.related}</h2>
      <a href={artist.href} class="related-artist link-underline">
        <span>{t.artworks.viewArtist}</span>
      </a>
    </div>
    <hr class="section-rule" />
    <div class="related-body">
      <ul class="related-grid">
        {related.map((item) => (
          <ArtworkCard presentation={item} />
        ))}
      </ul>
      <aside class="related-artist-card">
        <div class="related-artist-card-inner">
          {portrait && (
            <Image
              src={portrait.src}
              alt={portrait.alt}
              format="webp"
              width={600}
              class="related-portrait"
            />
          )}
          <p class="related-bio">{artist.shortBio}</p>
        </div>
      </aside>
    </div>
  </section>

  <Footer locale={locale} />
</MainLayout>

<style>
  /* Unlock Gallery */
  .unlock-gallery-section {
    margin-block: calc(80 * var(--unit-fx));
    border-top: 1px solid var(--color-divider);
    border-bottom: 1px solid var(--color-divider);
    background-color: var(--color-bg-overlay);
    padding-block: calc(60 * var(--unit-fx));
    padding-inline: var(--gutter);
  }

  .gallery-header {
    margin-bottom: calc(40 * var(--unit-fx));
    max-width: calc(900 * var(--unit-fx));
  }

  .gallery-badge {
    display: inline-block;
    margin-bottom: calc(12 * var(--unit-fx));
    border: 1px solid rgba(217, 119, 6, 0.3);
    border-radius: calc(100 * var(--unit-fx));
    background-color: rgba(217, 119, 6, 0.1);
    padding: calc(4 * var(--unit-fx)) calc(12 * var(--unit-fx));
    color: var(--color-brand-text);
    font-weight: 700;
    font-size: calc(11 * var(--unit-type));
    letter-spacing: 0.08em;
  }

  .gallery-title {
    margin-bottom: calc(14 * var(--unit-fx));
    color: var(--color-text-primary);
    font-weight: 400;
    font-size: calc(32 * var(--unit-type));
    font-family: var(--font-baskervville);
  }

  .gallery-subtitle {
    opacity: 0.85;
    color: var(--color-text-secondary);
    font-size: calc(15 * var(--unit-type));
    line-height: 1.7;
  }

  .unlock-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: calc(24 * var(--unit-fx));
  }

  .unlock-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--color-divider);
    border-radius: calc(8 * var(--unit-fx));
    background-color: var(--color-bg-primary);
  }

  .unlock-img {
    width: 100%;
    height: calc(220 * var(--unit-fx));
    object-fit: cover;
  }

  .unlock-caption {
    display: flex;
    align-items: center;
    gap: calc(12 * var(--unit-fx));
    border-top: 1px solid var(--color-divider);
    padding: calc(14 * var(--unit-fx)) calc(16 * var(--unit-fx));
  }

  .unlock-step {
    color: var(--color-brand-text);
    font-weight: 700;
    font-size: calc(14 * var(--unit-type));
    font-family: monospace;
  }

  .unlock-text {
    color: var(--color-text-primary);
    font-weight: 500;
    font-size: calc(12 * var(--unit-type));
    line-height: 1.4;
  }

  @media screen and (max-width: 900px) {
    .unlock-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 600px) {
    .unlock-grid {
      grid-template-columns: 1fr;
    }
  }

  .artwork {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: calc(50 * var(--unit-fx));
    margin-block: calc(80 * var(--unit-fx));
    padding-inline: var(--gutter);
  }

  .artwork-info {
    display: flex;
    position: sticky;
    top: calc(80 * var(--unit-fx));
    flex-direction: column;
    justify-content: flex-start;
    gap: calc(14 * var(--unit-fx));
    padding-block: calc(20 * var(--unit-fx));
  }

  .artwork-price-tag strong {
    color: var(--color-brand-text);
  }

  .artwork-cta-box {
    display: flex;
    flex-direction: column;
    gap: calc(10 * var(--unit-fx));
    margin: calc(12 * var(--unit-fx)) 0;
  }

  .artwork-cta-link {
    padding-inline: calc(24 * var(--unit-fx)) !important;
    width: auto !important;
    max-width: fit-content;
    text-align: center;
  }

  .artwork-promo-pill {
    display: inline-flex;
    align-items: center;
    gap: calc(8 * var(--unit-fx));
    font-size: calc(14 * var(--unit-type));
  }

  .artwork-promo-pill code {
    border: 1px dashed var(--color-brand);
    border-radius: var(--radius);
    background: var(--color-bg-overlay);
    padding: calc(3 * var(--unit-fx)) calc(10 * var(--unit-fx));
    color: var(--color-brand-text);
    font-weight: 700;
  }

  .artwork-affiliate-note {
    opacity: 0.65;
    margin: 0;
    max-width: 48ch;
    font-size: calc(11 * var(--unit-type));
  }

  .artwork-heading {
    margin-top: 0.5rem;
    font-weight: 300;
    font-size: calc(40 * var(--unit-type));
  }

  .artwork-heading > span {
    display: block;
  }

  .artwork-title {
    margin-top: calc(5 * var(--unit-fx));
    color: var(--color-brand);
    font-family: var(--font-baskervville);
  }

  .artwork-dimensions,
  .artwork-medium {
    font-size: calc(35 * var(--unit-type));
  }

  .artwork-caps {
    font-variant: small-caps;
  }

  .artwork-description {
    margin-top: calc(15 * var(--unit-fx));
    max-width: 50ch;
    font-size: calc(14 * var(--unit-type));
  }

  .artwork-action,
  .artwork-status {
    margin: calc(20 * var(--unit-fx)) 0;
    width: 30%;
    font-size: calc(16 * var(--unit-type));
  }

  .artwork-status {
    border: calc(1 * var(--unit-fx)) solid var(--color-text-primary);
    border-radius: var(--radius);
    background-color: var(--color-text-primary);
    padding: calc(10 * var(--unit-fx)) calc(20 * var(--unit-fx));
    color: var(--color-bg-primary);
    font-weight: 600;
    letter-spacing: calc(1 * var(--unit-fx));
    text-align: center;
    text-transform: uppercase;
  }

  .artwork-notes {
    display: flex;
    gap: calc(15 * var(--unit-fx));
    margin-top: auto;
    max-width: 35vw;
  }

  .artwork-notes > div {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: calc(11 * var(--unit-fx));
  }

  .artwork-notes dt {
    font-size: calc(13 * var(--unit-type));
  }

  .artwork-notes dd {
    font-size: calc(10 * var(--unit-type));
  }

  .artwork-media {
    overflow: hidden;
  }

  .artwork-zoom {
    position: relative;
  }

  .artwork-zoom img {
    border-radius: var(--radius);
    width: 100%;
    height: auto;
  }

  .artwork-zoom::after {
    position: absolute;
    opacity: 0;
    transition: opacity 0.2s ease;
    inset: 0;
    border-radius: var(--radius);
    background-image: var(--zoom-url);
    background-position: var(--zoom-x) var(--zoom-y);
    background-size: 200%;
    background-color: var(--color-bg-primary);
    pointer-events: none;
    content: "";
  }

  .artwork-zoom.is-zooming::after {
    opacity: 1;
  }

  .related {
    margin-block: calc(80 * var(--unit-fx));
    padding-inline: var(--gutter);
  }

  .related-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }

  .related-artist {
    font-weight: 300;
    font-size: calc(25 * var(--unit-type));
  }

  .related-artist span {
    display: flex;
    align-items: center;
    gap: calc(10 * var(--unit-fx));
  }

  .related-artist :global(svg) {
    width: calc(25 * var(--unit-fx));
    height: calc(25 * var(--unit-fx));
  }

  .related-body {
    display: grid;
    position: relative;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: calc(50 * var(--unit-fx));
    margin-block: calc(50 * var(--unit-fx));
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: calc(50 * var(--unit-fx));
    list-style: none;
  }

  .related-grid :global(.artwork-card) {
    max-width: calc(250 * var(--unit-fx));
  }

  .related-grid :global(.artwork-card-image) {
    height: calc(350 * var(--unit-fx));
  }

  .related-artist-card {
    margin-left: auto;
    width: 17vw;
    pointer-events: none;
  }

  .related-artist-card-inner {
    position: sticky;
    top: calc(30 * var(--unit-fx));
  }

  .related-portrait {
    border-radius: var(--radius);
    width: 100%;
    height: 20vw;
    object-fit: cover;
  }

  .related-bio {
    padding-top: calc(10 * var(--unit-fx));
    font-size: calc(14 * var(--unit-type));
  }

  /* Tablets: image first, then the details at readable sizes. */
  @media screen and (max-width: 1024px) {
    .artwork {
      display: flex;
      flex-direction: column-reverse;
      gap: calc(40 * var(--unit-fx));
    }

    .artwork-info {
      position: static;
      gap: calc(30 * var(--unit-fx));
      padding-block: 0;
      max-height: none;
    }

    .artwork-heading {
      font-size: calc(32 * var(--unit-type));
    }

    .artwork-dimensions,
    .artwork-medium {
      font-size: calc(24 * var(--unit-type));
    }

    .artwork-description {
      font-size: calc(16 * var(--unit-type));
    }

    .artwork-action,
    .artwork-status {
      align-self: flex-start;
      width: auto;
      min-width: 30%;
    }

    .artwork-notes {
      max-width: 100%;
    }

    .artwork-notes dt {
      font-size: calc(14 * var(--unit-type));
    }

    .artwork-notes dd {
      font-size: calc(13 * var(--unit-type));
    }

    .related-artist-card {
      width: 25vw;
    }

    .related-portrait {
      height: 30vw;
    }

    .related-bio {
      font-size: calc(15 * var(--unit-type));
    }
  }

  @media screen and (max-width: 600px) {
    .artwork {
      gap: calc(25 * var(--unit-fx));
    }

    .artwork-info {
      gap: calc(25 * var(--unit-fx));
    }

    .artwork-heading {
      font-size: calc(20 * var(--unit-type));
    }

    .artwork-dimensions,
    .artwork-medium {
      font-size: calc(15 * var(--unit-type));
    }

    .artwork-action,
    .artwork-status {
      order: 2;
      width: 100%;
    }

    .artwork-notes {
      flex-direction: column;
      max-width: 100%;
    }

    .artwork-notes dd,
    .artwork-description {
      font-size: calc(13 * var(--unit-type));
    }

    .related-artist {
      font-size: calc(18 * var(--unit-type));
    }

    .related-artist :global(svg) {
      width: calc(15 * var(--unit-fx));
      height: calc(15 * var(--unit-fx));
    }

    .related-body {
      display: block;
    }

    .related-grid {
      column-gap: calc(20 * var(--unit-fx));
    }

    .related-grid :global(.artwork-card-image) {
      height: calc(220 * var(--unit-fx));
    }

    .related-artist-card {
      display: none;
    }
  }
</style>

<script>
  import { ScrollTrigger } from "@scripts/motion";

  // Keep the artist card pinned while the related grid scrolls past it.
  const body = document.querySelector<HTMLElement>(".related-body");
  const card = document.querySelector<HTMLElement>(".related-artist-card");
  if (body && card) {
    ScrollTrigger.create({
      trigger: body,
      start: "top top",
      end: () => `+=${body.offsetHeight - card.offsetHeight}`,
      pin: true,
      scrub: 0.5,
    });
  }

  // Hover zoom: the enlarged image follows the pointer. The large image is
  // only requested once the pointer enters, not on page load.
  const zoom = document.querySelector<HTMLElement>(".artwork-zoom");
  if (zoom) {
    zoom.addEventListener(
      "mouseenter",
      () =>
        zoom.style.setProperty("--zoom-url", `url("${zoom.dataset.zoomSrc}")`),
      { once: true },
    );
    zoom.addEventListener("mousemove", (event) => {
      zoom.classList.add("is-zooming");
      zoom.style.setProperty(
        "--zoom-x",
        `${(event.offsetX * 100) / zoom.offsetWidth}%`,
      );
      zoom.style.setProperty(
        "--zoom-y",
        `${(event.offsetY * 100) / zoom.offsetHeight}%`,
      );
    });
    zoom.addEventListener("mouseleave", () =>
      zoom.classList.remove("is-zooming"),
    );
  }
</script>

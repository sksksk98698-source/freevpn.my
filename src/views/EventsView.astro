---
/** Exhibitions grouped by status, followed by the workshops. */
import MainLayout from "@layouts/MainLayout.astro";
import Navbar from "@sections/Chrome/Navbar.astro";
import Footer from "@sections/Chrome/Footer.astro";
import ExhibitionCard from "@sections/Programme/ExhibitionCard.astro";
import WorkshopCard from "@sections/Programme/WorkshopCard.astro";
import { useUI, type Locale } from "@/i18n";
import { getEvents } from "@utils/content";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useUI(locale);
const {
  exhibitions: { current, upcoming, past },
  workshops,
} = await getEvents(locale);
---

<MainLayout
  locale={locale}
  title={t.events.title}
  description={t.events.description}
>
  <Navbar locale={locale} />

  <section class="events">
    <header class="events-hero-header">
      <h1 class="events-main-title">
        {locale === "en"
          ? "Independent Benchmark Exhibitions & Technical Workshops"
          : "网络加速专题实测特展与前沿技术工作坊"}
      </h1>
      <p class="events-hero-desc">
        {locale === "en"
          ? "Deep technical evaluations comparing cross-border network architectures, evening peak single-thread speed tests, and protocol bypass mechanisms. Explore our ongoing flagship reports, ISP QoS diagnostic labs, and step-by-step workshops."
          : "汇集 FreeVPN.my 实测实验室关于跨境网络工程学、IEPL/IPLC 物理专线与晚高峰抗封锁特性的全景专题。从免费 VPN 供应链黑客陷阱、42 家机场单线程跑分天梯，到 Clash Verge Rev TUN 模式与 Sing-box 零拷贝进阶实操，为您提供高信息密度的专业参考。"}
      </p>
      <div class="events-metrics-tags">
        <span>✓ 42 家真机测速天梯</span>
        <span>✓ 2.5Gbps 双向 IEPL 架构</span>
        <span>✓ 500 次 ICMP 探针采样</span>
        <span>✓ 全平台客户端配置保姆教程</span>
      </div>
    </header>
    {current.length > 0 && (
      <>
        <h2 class="section-heading">{t.events.current}</h2>
        <hr class="section-rule" />
        <ul class="events-current">
          {current.map((exhibition) => (
            <ExhibitionCard exhibition={exhibition} />
          ))}
        </ul>
      </>
    )}

    {upcoming.length > 0 && (
      <>
        <h2 class="section-heading">{t.events.upcoming}</h2>
        <hr class="section-rule" />
        <ul class="events-upcoming">
          {upcoming.map((exhibition) => (
            <ExhibitionCard exhibition={exhibition} />
          ))}
        </ul>
      </>
    )}

    {past.length > 0 && (
      <>
        <h2 class="section-heading">{t.events.past}</h2>
        <hr class="section-rule" />
        <ul class="events-past">
          {past.map((exhibition) => (
            <ExhibitionCard exhibition={exhibition} />
          ))}
        </ul>
      </>
    )}

    {workshops.length > 0 && (
      <>
        <h2 class="section-heading">{t.events.workshops}</h2>
        <hr class="section-rule" />
        <div class="events-workshops">
          {workshops.map((workshop) => (
            <WorkshopCard workshop={workshop} />
          ))}
        </div>
      </>
    )}
  </section>

  <Footer locale={locale} />
</MainLayout>

<style>
  .events {
    margin-block: calc(120 * var(--unit-fx));
    padding-inline: var(--gutter);
  }

  .events-current {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    row-gap: calc(100 * var(--unit-fx));
    margin-top: calc(50 * var(--unit-fx));
    margin-bottom: calc(100 * var(--unit-fx));
    list-style: none;
  }

  .events-upcoming {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: calc(50 * var(--unit-fx));
    margin-top: calc(50 * var(--unit-fx));
    margin-bottom: calc(100 * var(--unit-fx));
    list-style: none;
  }

  .events-past {
    position: relative;
    margin-top: calc(50 * var(--unit-fx));
    margin-bottom: calc(200 * var(--unit-fx));
    list-style: none;
  }

  .events-workshops {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: calc(35 * var(--unit-fx));
    margin-top: calc(50 * var(--unit-fx));
    margin-bottom: calc(100 * var(--unit-fx));
    width: 100%;
  }

  @media screen and (max-width: 600px) {
    .events-current {
      display: flex;
      flex-direction: column;
      gap: calc(25 * var(--unit-fx));
      margin-top: calc(25 * var(--unit-fx));
      margin-bottom: calc(50 * var(--unit-fx));
    }

    .events-upcoming {
      display: flex;
      flex-direction: column;
      margin-top: calc(25 * var(--unit-fx));
      margin-bottom: calc(50 * var(--unit-fx));
    }

    .events-past {
      margin-top: calc(25 * var(--unit-fx));
      margin-bottom: calc(50 * var(--unit-fx));
    }

    /* Full-bleed strip so the last card can scroll fully into view. */
    .events-workshops {
      flex-wrap: nowrap;
      justify-content: flex-start;
      gap: calc(10 * var(--unit-fx));
      margin-inline: calc(-1 * var(--gutter));
      padding-inline: var(--gutter);
      width: auto;
      overflow-x: auto;
      scroll-padding-inline: var(--gutter);
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }
  }
</style>

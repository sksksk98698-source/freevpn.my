---
/**
 * One row of an artists list (the artists index and the homepage);
 * hovering the name reveals the portrait and short bio. Spacing between
 * rows belongs to the list that holds them.
 */
import { Image } from "astro:assets";
import type { ArtistPresentation } from "@utils/artists";

interface Props {
  artist: ArtistPresentation;
}

const { artist } = Astro.props;
const { portrait } = artist;
---

<li class="artist-row">
  <a class="artist-row-link" href={artist.href}>
    <span class="artist-row-name">{artist.name}</span>
    <span class="artist-row-arrow" aria-hidden="true">
      →
    </span>
  </a>
  <div class="artist-row-preview">
    <div class="artist-row-preview-inner">
      {portrait && (
        <Image
          src={portrait.src}
          alt={portrait.alt}
          format="webp"
          width={600}
          class="artist-row-portrait"
        />
      )}
      <p class="artist-row-bio">{artist.shortBio}</p>
    </div>
  </div>
</li>

<style>
  .artist-row {
    border-bottom: 1px solid var(--color-divider);
  }

  .artist-row:first-child {
    border-top: 1px solid var(--color-divider);
  }

  .artist-row-link {
    display: flex;
    position: relative;
    justify-content: space-between;
    align-items: center;
    transition:
      color var(--transition-fast),
      transform var(--transition-fast),
      padding-left var(--transition-fast);
    padding-block: calc(18 * var(--unit-fx));
    color: var(--color-text-primary);
    font-weight: 600;
    font-size: calc(34 * var(--unit-type));
    line-height: 1.3;
    font-family:
      var(--font-satoshi),
      system-ui,
      -apple-system,
      sans-serif;
    text-decoration: none;
    opacity: 1;
  }

  .artist-row-name {
    color: inherit;
  }

  .artist-row-link:hover,
  .artist-row-link:focus-visible {
    padding-left: calc(12 * var(--unit-fx));
    color: var(--color-brand-text);
  }

  .artist-row-arrow {
    opacity: 0.65;
    transition:
      opacity var(--transition-fast),
      transform var(--transition-fast);
    color: var(--color-text-primary);
    font-weight: 600;
    font-size: calc(28 * var(--unit-type));
  }

  .artist-row-link:hover .artist-row-arrow,
  .artist-row-link:focus-visible .artist-row-arrow {
    transform: translateX(calc(6 * var(--unit-fx)));
    opacity: 1;
    color: var(--color-brand-text);
  }

  .artist-row-preview {
    position: absolute;
    top: 0;
    right: 0;
    opacity: 0;
    transition: opacity var(--transition-fast);
    width: calc(230 * var(--unit-fx));
    height: 100vh;
    pointer-events: none;
  }

  .artist-row-link:hover ~ .artist-row-preview {
    opacity: 1;
  }

  .artist-row-preview-inner {
    position: sticky;
    top: calc(30 * var(--unit-fx));
  }

  .artist-row-portrait {
    border-radius: var(--radius);
    width: calc(230 * var(--unit-fx));
    height: 20vw;
    object-fit: cover;
  }

  .artist-row-bio {
    padding-top: calc(10 * var(--unit-fx));
    font-size: calc(14 * var(--unit-type));
    font-family: var(--font-satoshi);
  }

  @media screen and (max-width: 600px) {
    .artist-row-link {
      font-size: calc(25 * var(--unit-type));
    }

    .artist-row-preview {
      display: none;
    }
  }
</style>
